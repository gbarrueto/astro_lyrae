---
import "@/styles/global.css";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Lyrae Astronomía — Astroturismo",
	description = "Experiencias de astroturismo: observación visual con telescopio, astronomía asistida electrónicamente (EAA) y fotografía nocturna guiada.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0d1220" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<title>{title}</title>
	</head>
	<body>
		<div class="starfield" aria-hidden="true"></div>
		<slot />
	</body>
</html>

<style>
	/* Cielo de fondo: un resplandor frío arriba (la Vía Láctea asomando) más
	   unas pocas estrellas. Todo en CSS — cero imágenes, cero JS. */
	.starfield {
		position: fixed;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		background-image:
			radial-gradient(1.5px 1.5px at 12% 8%, oklch(0.98 0.02 90 / 0.9), transparent 100%),
			radial-gradient(1px 1px at 78% 14%, oklch(0.95 0.02 250 / 0.8), transparent 100%),
			radial-gradient(1.5px 1.5px at 34% 22%, oklch(0.98 0.01 260 / 0.7), transparent 100%),
			radial-gradient(1px 1px at 62% 33%, oklch(0.95 0.03 80 / 0.75), transparent 100%),
			radial-gradient(1px 1px at 22% 47%, oklch(0.96 0.02 250 / 0.6), transparent 100%),
			radial-gradient(1.5px 1.5px at 88% 56%, oklch(0.98 0.02 90 / 0.7), transparent 100%),
			radial-gradient(1px 1px at 45% 68%, oklch(0.95 0.02 260 / 0.6), transparent 100%),
			radial-gradient(1px 1px at 70% 82%, oklch(0.96 0.03 80 / 0.65), transparent 100%),
			radial-gradient(1.5px 1.5px at 16% 90%, oklch(0.98 0.01 250 / 0.6), transparent 100%),
			radial-gradient(120% 55% at 50% 0%, oklch(0.34 0.07 272 / 0.85), transparent 72%);
	}
</style>
