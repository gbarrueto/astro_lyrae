---
import { HugeiconsIcon } from "@hugeicons/react";
import { WhatsappIcon, InstagramIcon, Globe02Icon } from "@hugeicons/core-free-icons";

const organizations = [
	{
		name: "Lyrae Astronomía",
		note: "Opera las salidas de observación.",
		links: [
			{
				icon: WhatsappIcon,
				kind: "WhatsApp",
				label: "+56 9 8814 7137",
				href: "https://wa.me/56988147137",
			},
			{
				icon: InstagramIcon,
				kind: "Instagram",
				label: "@astro.lyrae",
				href: "https://instagram.com/astro.lyrae",
			},
		],
	},
	{
		name: "Turismo Entre Cordilleras",
		note: "El complejo donde se alojan nuestros visitantes. Reserva tu cabaña acá.",
		links: [
			{
				icon: Globe02Icon,
				kind: "Sitio web",
				label: "entrecordilleras.cl",
				href: "https://www.entrecordilleras.cl",
			},
			{
				icon: WhatsappIcon,
				kind: "Teléfono",
				label: "+56 9 3458 3222",
				href: "https://wa.me/56934583222",
			},
			{
				icon: InstagramIcon,
				kind: "Instagram",
				label: "@turismoentrecordilleras",
				href: "https://instagram.com/turismoentrecordilleras",
			},
		],
	},
];
---

<section id="contacto" class="px-5 py-16">
	<div class="mx-auto w-full max-w-2xl">
		<header class="mb-8 text-center">
			<h2 class="font-heading text-3xl font-semibold tracking-tight text-balance">
				Contáctanos
			</h2>
		</header>

		<div class="space-y-5">
			{
				organizations.map((org) => (
					<div class="rounded-2xl bg-card p-5 ring-1 ring-white/10">
						<h3 class="font-heading text-lg font-medium">{org.name}</h3>
						<p class="mt-1 text-sm leading-relaxed text-muted-foreground">{org.note}</p>
						<ul class="mt-3 space-y-1">
							{org.links.map((link) => (
								<li>
									<a
										href={link.href}
										target="_blank"
										rel="noopener noreferrer"
										class="-mx-2 flex min-h-12 items-center gap-3 rounded-xl px-2 transition hover:bg-white/5 focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
									>
										<span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-primary/12 text-primary">
											<HugeiconsIcon icon={link.icon} size={18} />
										</span>
										<span class="min-w-0">
											<span class="block text-xs text-muted-foreground">{link.kind}</span>
											<span class="block truncate text-sm font-medium">{link.label}</span>
										</span>
									</a>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>

		<footer class="mt-12 border-t border-white/10 pt-6 text-center text-xs text-muted-foreground">
			<p class="mx-auto max-w-md leading-relaxed">
				Nuestros servicios astronómicos se ofrecen exclusivamente a huéspedes de Turismo Entre
				Cordilleras y se realizan dentro del complejo.
			</p>
			<p class="mt-4">Made by <span class="text-foreground">gbarrueto</span> 2025</p>
		</footer>
	</div>
</section>
