---
const observableHours = [21, 22, 23, 0, 1, 2];
---
<section>
    <div>
        <h3>¿A qué hora quieres observar?</h3>
        <div>
            {observableHours.map(hour => (
                <button>
                    {hour.toString().padStart(2, '0')}
                </button>
            ))}
        </div>
    </div>
    <div>
        <iframe 
            src="https://www.meteoblue.com/es/tiempo/widget/seeing/-37.643N-71.695E460_America%2FSantiago?geoloc=fixed&noground=0"
            style={{ 
                width: "520px", 
                height: "774px", 
                border: "none", 
                borderRadius: "8px"
            }}
            scrolling="no"
            title="Meteoblue Seeing Widget"
        ></iframe>
        
        <div>
            <a 
                href="https://www.meteoblue.com/es/tiempo/pronostico/seeing/-37.643N-71.695E460_America%2FSantiago?utm_source=seeing_widget&utm_medium=linkus&utm_content=seeing&utm_campaign=Weather%2BWidget"
                target="_blank"
                rel="noreferrer noopener"
            >
                meteoblue
            </a>
        </div>
    </div>
</section>