---
import forecast from "@/data/forecast.json";
import { NightPanel } from "./NightPanel";
import type { NightData } from "@/lib/sky";

const { nights, model, generatedAt } = forecast;

const updated = new Intl.DateTimeFormat("es-CL", {
	timeZone: "America/Santiago",
	day: "2-digit",
	month: "2-digit",
	hour: "2-digit",
	minute: "2-digit",
	hour12: false,
}).format(new Date(generatedAt));
---

<section id="pronostico" class="px-5 pt-14 pb-16">
	<div class="mx-auto w-full max-w-lg">
		<header class="mb-4">
			<p class="text-[10px] font-bold tracking-[0.18em] text-primary uppercase">
				Antes de reservar
			</p>
			<h2 class="mt-1 font-heading text-3xl leading-tight font-semibold tracking-tight text-balance">
				¿Cómo estará la noche?
			</h2>
		</header>

		<NightPanel
			client:visible
			nights={nights as unknown as NightData[]}
			timeZone={forecast.site.timeZone}
			whatsappNumber="56988147137"
		/>

		<p class="mt-3 text-center text-[10px] leading-relaxed text-muted-foreground">
			Pronóstico de <a
				href="https://www.7timer.info/"
				target="_blank"
				rel="noopener noreferrer"
				class="text-primary underline underline-offset-[3px]">{model.name}</a
			> sobre {model.basis} · un dato cada {model.resolution} · act. {updated}
		</p>
	</div>
</section>
