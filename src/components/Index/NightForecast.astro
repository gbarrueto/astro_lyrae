---
import forecast from "@/data/forecast.json";
import { NightSegments } from "./NightSegments";
import { NightBar, type NightTimes } from "./NightBar";
import { MoonCard, type MoonInfo } from "./MoonCard";
import { Phrase } from "@/components/Phrase";
import type { NightSegment, Phrase as Parts } from "@/lib/sky";

const { night, model, generatedAt } = forecast;

const anyObscured = night.segments.some((segment) => segment.obscured);

const VERDICT = {
	bueno: { label: "Buena noche para observar", chip: "text-good ring-good/30 bg-good/10" },
	regular: { label: "Noche irregular", chip: "text-warn ring-warn/30 bg-warn/10" },
	malo: { label: "Mala noche para observar", chip: "text-bad ring-bad/30 bg-bad/10" },
	imposible: { label: "No se puede observar", chip: "text-off ring-off/30 bg-off/10" },
} as const;

const verdict = VERDICT[night.verdict as keyof typeof VERDICT] ?? VERDICT.malo;
const impossible = night.verdict === "imposible";

const whatsappHref = `https://wa.me/56988147137?text=${encodeURIComponent(
	"Hola, me gustaría salir a observar esta noche. ¿Alcanzamos?",
)}`;

// En UTC a propósito: `new Date("2026-07-28")` retrocede un día en zonas negativas.
const [year, month, day] = night.date.split("-").map(Number);
const nightLabel = new Intl.DateTimeFormat("es-CL", {
	timeZone: "UTC",
	weekday: "long",
	day: "numeric",
	month: "long",
}).format(new Date(Date.UTC(year, month - 1, day)));

const updated = new Intl.DateTimeFormat("es-CL", {
	timeZone: "America/Santiago",
	day: "2-digit",
	month: "2-digit",
	hour: "2-digit",
	minute: "2-digit",
	hour12: false,
}).format(new Date(generatedAt));

---

<section id="pronostico" class="px-5 py-16">
	<div class="mx-auto w-full max-w-2xl">
		<header class="mb-8 space-y-3 text-center">
			<h2 class="font-heading text-3xl font-semibold tracking-tight text-balance">
				¿Cómo estará la noche?
			</h2>
			<p class="text-sm text-muted-foreground">
				Pronóstico para la noche del {nightLabel}.
			</p>
		</header>

		<div class="rounded-2xl bg-card p-6 text-center ring-1 ring-white/10">
			<p
				class:list={[
					"inline-flex items-center rounded-full px-4 py-1.5 text-xs font-medium tracking-[0.14em] uppercase ring-1",
					verdict.chip,
				]}
			>
				{verdict.label}
			</p>
			<p class="mt-4 text-base leading-relaxed text-pretty">
				<Phrase parts={night.headline as Parts} />
			</p>
		</div>

		<div class="mt-5">
			<NightBar
				client:visible
				night={night as unknown as NightTimes}
				timeZone={forecast.site.timeZone}
				impossible={impossible}
				whatsappHref={whatsappHref}
			/>
		</div>

		<div class="mt-4">
			<MoonCard moon={night.moon as MoonInfo} />
		</div>

		<div class="mt-8">
			<NightSegments client:visible segments={night.segments as NightSegment[]} />
		</div>

		{
			anyObscured && (
				<p class="mt-4 rounded-2xl bg-card/60 p-4 text-xs leading-relaxed text-muted-foreground ring-1 ring-white/5">
					<strong class="font-medium text-foreground">Seeing y transparencia van tachados</strong>{" "}
					cuando el cielo está cubierto: miden qué tan quieta y limpia está la atmósfera,
					pero si hay nubes de por medio da lo mismo — no hay por dónde mirar.
				</p>
			)
		}

		{
			night.windWarning && (
				<p class="mt-4 rounded-2xl bg-card/60 p-4 text-xs leading-relaxed text-muted-foreground ring-1 ring-white/5">
					<Phrase parts={night.windWarning as Parts} />
				</p>
			)
		}

		<p class="mt-6 text-center text-xs text-muted-foreground">
			Pronóstico de <a
				href="https://www.7timer.info/"
				target="_blank"
				rel="noopener noreferrer"
				class="text-primary underline underline-offset-4">{model.name}</a
			> sobre el modelo {model.basis}, con un dato cada {model.resolution}. Actualizado el {
				updated
			}.
		</p>
	</div>
</section>
