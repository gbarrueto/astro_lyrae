---
import { HugeiconsIcon } from "@hugeicons/react";
import {
	SunsetIcon,
	Moon02Icon,
	CloudIcon,
	Clock01Icon,
	ArrowUp01Icon,
} from "@hugeicons/core-free-icons";
import forecast from "@/data/forecast.json";
import { windArrow } from "@/lib/sky";

// El pronóstico lo escribe scripts/forecast.mjs una vez al día (7Timer! ASTRO)
// y viaja como archivo: acá no se consulta nada en tiempo de render.
const { night, model, generatedAt } = forecast;

// Cada tramo trae `obscured`: con el cielo tapado, el seeing y la transparencia
// no cambian nada, así que se muestran anulados en vez de esconderlos.
const anyObscured = night.segments.some((segment) => segment.obscured);

const VERDICT = {
	bueno: {
		label: "Buena noche para observar",
		chip: "text-emerald-300 ring-emerald-400/30 bg-emerald-400/10",
	},
	regular: {
		label: "Noche irregular",
		chip: "text-amber-300 ring-amber-400/30 bg-amber-400/10",
	},
	malo: {
		label: "Mala noche para observar",
		chip: "text-rose-300 ring-rose-400/30 bg-rose-400/10",
	},
} as const;

const QUALITY = {
	bueno: "text-emerald-300",
	regular: "text-amber-300",
	malo: "text-rose-300",
} as const;

const verdict = VERDICT[night.verdict as keyof typeof VERDICT];
const quality = (value: string) => QUALITY[value as keyof typeof QUALITY];

// "2026-07-28" → "martes 28 de julio". Se construye en UTC a propósito: con
// `new Date("2026-07-28")` en una zona negativa, la fecha retrocede un día.
const [year, month, day] = night.date.split("-").map(Number);
const nightLabel = new Intl.DateTimeFormat("es-CL", {
	timeZone: "UTC",
	weekday: "long",
	day: "numeric",
	month: "long",
}).format(new Date(Date.UTC(year, month - 1, day)));

const updated = new Intl.DateTimeFormat("es-CL", {
	timeZone: "America/Santiago",
	day: "2-digit",
	month: "2-digit",
	hour: "2-digit",
	minute: "2-digit",
	hour12: false,
}).format(new Date(generatedAt));

const whatsappHref = `https://wa.me/56988147137?text=${encodeURIComponent(
	"Hola, me gustaría salir a observar esta noche. ¿Alcanzamos?",
)}`;

const moonNote =
	night.moon.interference === "alta"
		? "Aclara el cielo y tapa los objetos más tenues."
		: night.moon.interference === "media"
			? "Molesta algo para galaxias y nebulosas."
			: "No interfiere con la observación.";
---

<section id="pronostico" class="px-5 py-16">
	<div class="mx-auto w-full max-w-2xl">
		<header class="mb-8 space-y-3 text-center">
			<h2 class="font-heading text-3xl font-semibold tracking-tight text-balance">
				¿Cómo estará la noche?
			</h2>
			<p class="text-sm text-muted-foreground">
				Pronóstico para la noche del {nightLabel}.
			</p>
		</header>

		{/* El veredicto primero: es lo único que la mayoría necesita leer. */}
		<div class="rounded-2xl bg-card p-6 text-center ring-1 ring-white/10">
			<p
				class:list={[
					"inline-flex items-center rounded-full px-4 py-1.5 text-xs font-medium tracking-[0.14em] uppercase ring-1",
					verdict.chip,
				]}
			>
				{verdict.label}
			</p>
			<p class="mt-4 text-base leading-relaxed text-pretty">{night.headline}</p>
		</div>

		{/* Cuándo empieza a servir el cielo, y hasta cuándo se puede pedir la salida. */}
		<dl class="mt-4 grid gap-3 sm:grid-cols-3">
			<div class="flex items-center gap-3 rounded-2xl bg-card p-4 ring-1 ring-white/10">
				<span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-primary/12 text-primary">
					<HugeiconsIcon icon={SunsetIcon} size={18} />
				</span>
				<div class="min-w-0">
					<dt class="text-xs text-muted-foreground">Atardece</dt>
					<dd class="font-medium tabular-nums">{night.sunset}</dd>
				</div>
			</div>

			<div class="flex items-center gap-3 rounded-2xl bg-card p-4 ring-1 ring-white/10">
				<span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-primary/12 text-primary">
					<HugeiconsIcon icon={Clock01Icon} size={18} />
				</span>
				<div class="min-w-0">
					<dt class="text-xs text-muted-foreground">Cielo oscuro</dt>
					<dd class="font-medium tabular-nums">{night.darkFrom} – {night.darkUntil}</dd>
				</div>
			</div>

			<div class="flex items-center gap-3 rounded-2xl bg-card p-4 ring-1 ring-white/10">
				<span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-primary/12 text-primary">
					<HugeiconsIcon icon={Moon02Icon} size={18} />
				</span>
				<div class="min-w-0">
					<dt class="text-xs text-muted-foreground">Luna</dt>
					<dd class="font-medium">
						{night.moon.illumination}% <span class="text-xs font-normal text-muted-foreground">
							{night.moon.label}</span
						>
					</dd>
				</div>
			</div>
		</dl>

		<p class="mt-3 text-center text-xs leading-relaxed text-muted-foreground">{moonNote}</p>

		{/* El plazo se compara con el reloj en el cliente: el sitio es estático y
		    el archivo se genera una vez al día, así que acá no se sabe qué hora es
		    para quien está leyendo. Sin JavaScript queda el mensaje informativo,
		    que no miente: dice la hora tope. */}
		<div
			class="mt-2 text-center text-xs leading-relaxed text-muted-foreground"
			data-deadline
			data-deadline-at={night.bookingDeadlineAt}
			data-night-date={night.date}
			data-time-zone={forecast.site.timeZone}
		>
			<p data-deadline-state="ok">
				Para salir esta noche, avísanos antes de las <span
					class="font-medium text-foreground tabular-nums">{night.bookingDeadline}</span
				>.
			</p>

			<p data-deadline-state="late" hidden>
				La hora recomendada para avisar era las <span class="tabular-nums"
					>{night.bookingDeadline}</span
				>. <a
					href={whatsappHref}
					target="_blank"
					rel="noopener noreferrer"
					class="font-medium text-primary underline underline-offset-4"
					>Escríbenos igual</a
				> y vemos si alcanzamos a preparar el equipo.
			</p>

			<p data-deadline-state="stale" hidden>
				Este pronóstico es de la noche del <span class="tabular-nums">{nightLabel}</span>.
				Escríbenos y te contamos cómo se ve la de hoy.
			</p>
		</div>

		{/* Cómo evoluciona: el modelo entrega un punto cada 3 horas. */}
		<ul class="mt-8 space-y-3">
			{
				night.segments.map((segment) => (
					<li class="rounded-2xl bg-card p-5 ring-1 ring-white/10">
						<div class="flex items-baseline justify-between gap-3">
							<h3 class="font-heading text-base font-medium">{segment.label}</h3>
							<span class="text-sm text-muted-foreground tabular-nums">{segment.time}</span>
						</div>

						<p class="mt-3 flex items-center gap-2 text-sm">
							<HugeiconsIcon icon={CloudIcon} size={16} />
							<span class={`font-medium ${quality(segment.clouds.quality)}`}>
								{segment.clouds.label}
							</span>
							<span class="text-xs text-muted-foreground tabular-nums">
								{segment.clouds.range}
							</span>
						</p>

						<dl class="mt-3 grid grid-cols-2 gap-x-4 gap-y-1 border-t border-white/10 pt-3 text-sm">
							{/* Solo seeing y transparencia se anulan con nubes. La temperatura
							    y la humedad siguen sirviendo: dicen cuánto hay que abrigarse. */}
							<div
								class:list={[
									"flex items-baseline justify-between gap-2",
									segment.obscured && "opacity-45",
								]}
								title={
									segment.obscured
										? "Sin efecto con el cielo cubierto: no hay nada que observar."
										: undefined
								}
							>
								<dt class="text-xs text-muted-foreground">Seeing</dt>
								<dd
									class:list={[
										"text-right text-xs font-medium tabular-nums",
										segment.obscured ? "line-through" : quality(segment.seeing.quality),
									]}
								>
									{segment.seeing.range}
								</dd>
							</div>
							<div
								class:list={[
									"flex items-baseline justify-between gap-2",
									segment.obscured && "opacity-45",
								]}
								title={
									segment.obscured
										? "Sin efecto con el cielo cubierto: no hay nada que observar."
										: undefined
								}
							>
								<dt class="text-xs text-muted-foreground">Transparencia</dt>
								<dd
									class:list={[
										"text-right text-xs font-medium",
										segment.obscured ? "line-through" : quality(segment.transparency.quality),
									]}
								>
									{segment.transparency.label}
								</dd>
							</div>
							<div class="flex items-baseline justify-between gap-2">
								<dt class="text-xs text-muted-foreground">Temperatura</dt>
								<dd class="text-right text-xs font-medium tabular-nums">
									{segment.temperature} °C
								</dd>
							</div>
							<div class="flex items-baseline justify-between gap-2">
								<dt class="text-xs text-muted-foreground">Viento</dt>
								<dd class={`text-right text-xs font-medium ${quality(segment.wind.quality)}`}>
									{segment.wind.label}
									{
										windArrow(segment.wind.direction) && (
											<span
												class="ml-1 inline-block align-middle text-muted-foreground"
												title={windArrow(segment.wind.direction)!.label}
												aria-label={windArrow(segment.wind.direction)!.label}
												style={`transform: rotate(${windArrow(segment.wind.direction)!.deg}deg)`}
											>
												<HugeiconsIcon icon={ArrowUp01Icon} size={13} />
											</span>
										)
									}
								</dd>
							</div>
							<div class="flex items-baseline justify-between gap-2">
								<dt class="text-xs text-muted-foreground">Humedad</dt>
								<dd class="text-right text-xs font-medium tabular-nums">{segment.humidity}</dd>
							</div>
						</dl>
					</li>
				))
			}
		</ul>

		{
			anyObscured && (
				<p class="mt-4 rounded-2xl bg-card/60 p-4 text-xs leading-relaxed text-muted-foreground ring-1 ring-white/5">
					<strong class="font-medium text-foreground">Seeing y transparencia van tachados</strong>{" "}
					en los tramos con el cielo cubierto: miden qué tan quieta y limpia está la atmósfera,
					pero si hay nubes de por medio da lo mismo — no hay por dónde mirar.
				</p>
			)
		}

		{
			night.windWarning && (
				<p class="mt-4 rounded-2xl bg-card/60 p-4 text-xs leading-relaxed text-muted-foreground ring-1 ring-white/5">
					{night.windWarning}
				</p>
			)
		}

		<p class="mt-6 text-center text-xs text-muted-foreground">
			Pronóstico de <a
				href="https://www.7timer.info/"
				target="_blank"
				rel="noopener noreferrer"
				class="text-primary underline underline-offset-4">{model.name}</a
			> sobre el modelo {model.basis}, con un dato cada {model.resolution}. Actualizado el {
				updated
			}.
		</p>
	</div>
</section>

<script>
	// Qué mensaje del plazo corresponde a la hora en que alguien está mirando.
	const box = document.querySelector<HTMLElement>("[data-deadline]");

	if (box) {
		const deadline = Date.parse(box.dataset.deadlineAt ?? "");
		const nightDate = box.dataset.nightDate ?? "";
		const timeZone = box.dataset.timeZone ?? "America/Santiago";

		// Siempre contra la hora del complejo: quien planifica desde otro país
		// vería un plazo que no calza con el lugar donde va a observar.
		const dateFmt = new Intl.DateTimeFormat("en-CA", {
			timeZone,
			year: "numeric",
			month: "2-digit",
			day: "2-digit",
		});
		const hourFmt = new Intl.DateTimeFormat("es-CL", {
			timeZone,
			hour: "2-digit",
			hour12: false,
		});

		const show = (state: string) => {
			box.querySelectorAll<HTMLElement>("[data-deadline-state]").forEach((node) => {
				node.hidden = node.dataset.deadlineState !== state;
			});
		};

		const update = () => {
			const now = new Date();

			// Antes del mediodía, la noche vigente es la que empezó ayer: a las
			// 02:00 el pronóstico de "anoche" sigue siendo el de esta noche.
			const today = dateFmt.format(now);
			const hour = Number(hourFmt.format(now));
			const currentNight =
				hour < 12 ? dateFmt.format(new Date(now.getTime() - 12 * 3600e3)) : today;

			if (currentNight !== nightDate) return show("stale");
			show(Number.isNaN(deadline) || now.getTime() <= deadline ? "ok" : "late");
		};

		update();
		// Un minuto basta: el plazo se cruza una vez y no hay que acertarle al segundo.
		setInterval(update, 60_000);
		document.addEventListener("visibilitychange", () => {
			if (!document.hidden) update();
		});
	}
</script>
